---
import AppShell from "../../components/AppShell.astro";
import Card from "../../components/Card.astro";
import EmptyState from "../../components/EmptyState.astro";
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Mis eBooks | Generador de eBooks IA">
  <AppShell active="ebooks">
    <Card>
      <div class="module-toolbar">
        <div>
          <p class="eyebrow">Biblioteca local</p>
          <h2>Mis eBooks</h2>
        </div>
        <a class="button button-primary" href="/">Crear eBook</a>
      </div>
      <div class="library-filters">
        <label class="field" for="ebook-type-filter">
          <span>Filtrar por tipo</span>
          <select id="ebook-type-filter">
            <option value="">Todos los eBooks</option>
            <option value="standard">E-Books estándar</option>
            <option value="teacher_training">E-Books Capacitación Docente</option>
            <option value="law">E-Books Derecho</option>
            <option value="public_management">E-Books Gestión Pública</option>
            <option value="office">E-Books Ofimática</option>
            <option value="health">E-Books Sector Salud</option>
            <option value="technology">E-Books Tecnología</option>
            <option value="civil_engineering">E-Books Ingeniería Civil</option>
            <option value="agronomy">E-Books Agronomía o Cultivos</option>
          </select>
        </label>
      </div>
      <div id="ebooks-error" class="error-box is-hidden"></div>
      <div id="ebooks-empty">
        <EmptyState
          title="Aún no hay eBooks"
          text="Crea tu primer ebook desde la pantalla de inicio."
        />
      </div>
      <div id="ebooks-table-wrap" class="is-hidden">
        <table class="ebook-table">
          <thead>
            <tr>
              <th>Tema</th>
              <th>Estado</th>
              <th>Tipo</th>
              <th>Páginas</th>
              <th>Módulos</th>
              <th>Creado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="ebooks-table"></tbody>
        </table>
      </div>
    </Card>
  </AppShell>
</MainLayout>

<script>
  import { deleteEbook, listEbooks } from "../../scripts/api";
  import { EBOOK_TYPE_LABELS, type EbookType } from "../../scripts/types";

  const labels = {
    draft: "Borrador",
    generating: "Generando",
    completed: "Completado",
    failed: "Fallido",
  };

  const tableWrap = document.querySelector<HTMLElement>("#ebooks-table-wrap");
  const table = document.querySelector<HTMLElement>("#ebooks-table");
  const empty = document.querySelector<HTMLElement>("#ebooks-empty");
  const errorBox = document.querySelector<HTMLElement>("#ebooks-error");
  const typeFilter =
    document.querySelector<HTMLSelectElement>("#ebook-type-filter");

  function escapeHtml(value: string): string {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
  }

  async function loadEbooks() {
    try {
      const selectedType = typeFilter?.value as EbookType | undefined;
      const response = await listEbooks(selectedType || undefined);
      if (!response.items.length) {
        empty?.classList.remove("is-hidden");
        tableWrap?.classList.add("is-hidden");
        return;
      }
      empty?.classList.add("is-hidden");
      tableWrap?.classList.remove("is-hidden");
      if (!table) return;
      table.innerHTML = response.items
        .map(
          (ebook) => `
          <tr>
            <td>${escapeHtml(ebook.title || ebook.topic)}</td>
            <td><span class="status-badge status-${ebook.status}">${labels[ebook.status]}</span></td>
            <td><span class="type-badge type-${ebook.ebook_type}">${EBOOK_TYPE_LABELS[ebook.ebook_type]}</span></td>
            <td>${ebook.total_content_pages}</td>
            <td>${ebook.active_modules}</td>
            <td>${new Date(ebook.created_at).toLocaleString()}</td>
            <td>
              <div class="table-actions">
                <a class="button button-secondary" href="/ebooks/view?id=${encodeURIComponent(ebook.id)}">Abrir</a>
                <button class="button button-danger" type="button" data-delete="${ebook.id}">Eliminar</button>
              </div>
            </td>
          </tr>
        `,
        )
        .join("");
    } catch {
      if (errorBox) {
        errorBox.textContent = "No se pudo conectar con el backend.";
        errorBox.classList.remove("is-hidden");
      }
    }
  }

  table?.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const ebookId = target.dataset.delete;
    if (!ebookId) return;
    const confirmed = window.confirm(
      "¿Eliminar este ebook y sus archivos exportados?",
    );
    if (!confirmed) return;
    await deleteEbook(ebookId);
    await loadEbooks();
  });

  typeFilter?.addEventListener("change", loadEbooks);

  await loadEbooks();
</script>
